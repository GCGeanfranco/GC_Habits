GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FLASK_SECRET_KEY=generate-a-long-random-secret-python -c "import secrets; print(secrets.token_hex(32))"
# Entorno: "development" o "production". En development las cookies de
# sesión NO llevan Secure y no se fuerza HTTPS (permite probar en
# http://localhost); en production las cookies llevan Secure (solo HTTPS,
# Constitución §8) y se fuerza HTTPS.
FLASK_ENV=development
